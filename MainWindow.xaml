<Window x:Class="SILViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SILViewer"
        mc:Ignorable="d"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Window.Resources>
        <sys:Double x:Key="SplitterSize">5</sys:Double>

        <Style TargetType="GridSplitter">
            <Setter Property="Background"
                    Value="WhiteSmoke" />
        </Style>

        <CollectionViewSource x:Key="FilteredItems"
                              Source="{Binding LogItems}" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New"
                          Click="NewMenuItem_Click" />
                <MenuItem Header="_Open"
                          Click="OpenMenuItem_Click" />
                <MenuItem Header="_Save"
                          Click="SaveMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Exit"
                          Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Cut"
                          Click="CutMenuItem_Click" />
                <MenuItem Header="_Copy"
                          Click="CopyMenuItem_Click" />
                <MenuItem Header="_Paste"
                          Click="PasteMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About"
                          Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>Ready</TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content Area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Section (Split into 3 vertical partitions) -->
            <StackPanel Grid.Column="0">
                <Expander Header="Details"
                          IsExpanded="True">
                    <GroupBox Header="Section 1"
                              Margin="10">
                        <StackPanel>
                            <TextBlock Text="Content for Section 1"
                                       Margin="5" />
                            <Button Content="Button 1"
                                    Margin="5" />
                        </StackPanel>
                    </GroupBox>
                </Expander>
                <!--<Expander Header="Go To">
                    <StackPanel>
                        <TextBlock Text="Content for Section 1" Margin="5"/>
                        <Button Content="Button 1" Margin="5"/>
                    </StackPanel>
                </Expander>-->
                <Expander Header="Filter"
                          IsExpanded="True">
                    <GroupBox Header="Section 1"
                              Margin="10">
                        <StackPanel>
                            <CheckBox Content="Message"
                                      Unchecked="CheckBox_Checked"
                                      Checked="CheckBox_Checked" />
                            <CheckBox Content="Error"
                                      Unchecked="CheckBox_Checked"
                                      Checked="CheckBox_Checked" />
                            <CheckBox Content="Fatal"
                                      Unchecked="CheckBox_Checked"
                                      Checked="CheckBox_Checked" />
                        </StackPanel>
                    </GroupBox>
                </Expander>
            </StackPanel>
            <GridSplitter Grid.Column="1"
                          Width="{StaticResource SplitterSize}"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Center" />

            <!-- Right Section with TabControl -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0.3*" />
                </Grid.RowDefinitions>
                <TabControl x:Name="TabControl" Grid.Row="0" Margin="10" ItemsSource="{Binding TabItems}" SelectionChanged="TabControl_SelectionChanged">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ListView ItemsSource="{Binding Items}" SelectionChanged="ListView_SelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Height"
                                                Value="{Binding RowHeight}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <!-- Add more columns as needed -->
                                        <GridViewColumn Header="Item"
                                                        Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding Icon}"
                                                               Width="16"
                                                               Height="16"
                                                               Margin="0,0,5,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Title"
                                                        DisplayMemberBinding="{Binding Title}" />
                                        <GridViewColumn Header="ThreadId"
                                                        DisplayMemberBinding="{Binding ThreadId}" />
                                        <GridViewColumn Header="TimeStamp"
                                                        DisplayMemberBinding="{Binding TimeStamp}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
                <RichTextBox x:Name="LogData" Grid.Row="1"
                             Margin="10 0 10 10" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
